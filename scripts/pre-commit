#!/bin/sh
# stng pre-commit hook.
#
# Refuses the commit unless:
#   1. Cargo.toml has no local path override (scripts/check-overrides).
#   2. `make test` passes.
#   3. `make lint` passes.
#
# Install with: make install-precommit

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# 1. No local overrides in Cargo.toml.
scripts/check-overrides
echo ""

# 2. Tests.
make test

# 3. Lint.
make lint

echo ""
echo "✓ Pre-commit checks passed"
