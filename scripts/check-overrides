#!/bin/sh
# Fail if Cargo.toml has a dependency or [patch] entry that others cannot
# reproduce:
#   - a path that leaves the repo (absolute, ~, or through ..), which pins
#     against a sibling working tree;
#   - a [patch] git source without `rev = "<sha>"`, which follows a branch
#     head. Ordinary git dependencies may omit it: a dependent must resolve
#     a type-sharing dependency (binform) from the same source, and
#     Cargo.lock records the commit for stng's own builds.
# Paths inside the repo pass. Target paths under [lib]/[[bin]] are not
# dependencies and are ignored. Entries are expected on one line.
#
# Run by scripts/pre-commit and by CI.

set -e

cd "$(git rev-parse --show-toplevel)"
echo "Checking Cargo.toml for local overrides..."
overrides=$(awk '
	/^[[:space:]]*#/ { next }
	/^[[:space:]]*\[/ {
		section = $0
		sub(/^[[:space:]]*\[+/, "", section)
		sub(/\]+.*$/, "", section)
		next
	}
	section ~ /(^|\.)(dev-|build-)?dependencies(\.|$)/ || section ~ /^patch/ {
		if (section ~ /^patch/ && $0 ~ /(^|[{,[:space:]])git[[:space:]]*=/) {
			# No regex intervals: older mawk lacks them.
			rev = ""
			if (match($0, /(^|[{,[:space:]])rev[[:space:]]*=[[:space:]]*"[0-9a-f]+"/)) {
				rev = substr($0, RSTART, RLENGTH)
				sub(/^[^"]*"/, "", rev)
				sub(/"$/, "", rev)
			}
			if (length(rev) != 40) {
				printf "  %d: %s (git source without a full-sha rev)\n", NR, $0
			}
			next
		}
		if (!match($0, /(^|[{,[:space:]])path[[:space:]]*=[[:space:]]*"[^"]*"/)) {
			next
		}
		value = substr($0, RSTART, RLENGTH)
		sub(/^[^"]*"/, "", value)
		sub(/"$/, "", value)
		if (value ~ /^[\/~]/ || value ~ /(^|\/)\.\.(\/|$)/) {
			printf "  %d: %s\n", NR, $0
		}
	}
' Cargo.toml)

if [ -n "$overrides" ]; then
	echo "Error: Cargo.toml has unreproducible dependency sources; fix before committing:" >&2
	echo "$overrides" >&2
	exit 1
fi
echo "✓ No local overrides or unpinned git sources"
